includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - app/
    - database/
    - routes/
  level: 8

  ignoreErrors:
    # Every upsert counter goes through CounterExpression::addTo(int), so no
    # caller can inject anything: PHPStan simply cannot prove that a string
    # built at runtime is literal. Scoped to that single call on purpose —
    # any other raw expression in the codebase stays analysed.
    - identifier: argument.type
      message: '#expects float\|int\|literal-string, non-falsy-string given\.#'
      path: app/Support/CounterExpression.php
      count: 1
